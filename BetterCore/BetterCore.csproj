<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>

    <!-- Build tags -->
    <BuildForWindows>true</BuildForWindows>
    <BuildForWindowsStore>true</BuildForWindowsStore>

    <ModuleId>$(MSBuildProjectName)</ModuleId>
    <ModuleName>$(MSBuildProjectName)</ModuleName>

    <!-- Environment-supplied Bannerlord path -->
    <GameFolder>$(BANNERLORD_GAME_DIR)</GameFolder>
    <NugetFolder>$(NUGET_PACKAGES_DIR)</NugetFolder> <!-- Remove? -->

    <RunPostBuildEvent>OnBuildSuccess</RunPostBuildEvent>
    <BaseOutputPath>$(MSBuildProjectDirectory)\bin\</BaseOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Bannerlord.ReferenceAssemblies" Version="1.4.8.119303" />
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <None Update="_Module\SubModule.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Remove previous module folder -->
  <Target Name="PreBuild" BeforeTargets="PreBuildEvent">
    <Message Text="Deleting old module folder: $(GameFolder)\Modules\$(MSBuildProjectName)" Importance="high" />
    <Exec Command="IF EXIST &quot;$(GameFolder)\Modules\$(MSBuildProjectName)&quot; RMDIR /Q /S &quot;$(GameFolder)\Modules\$(MSBuildProjectName)&quot;" />
  </Target>

  <!-- Copy module files after build -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">

    <!-- Create module root -->
    <Exec Command="MKDIR &quot;$(GameFolder)\Modules\$(MSBuildProjectName)&quot;" />

    <!-- Create game bin folders -->
    <Exec Command="MKDIR &quot;$(GameFolder)\Modules\$(MSBuildProjectName)\bin\Win64_Shipping_Client&quot;" />
    <Exec Command="MKDIR &quot;$(GameFolder)\Modules\$(MSBuildProjectName)\bin\Gaming.Desktop.x64_Shipping_Client&quot;" />

    <!-- Copy module resource files -->
    <Exec Command="XCOPY /Y /E /H /C /I &quot;$(MSBuildProjectDirectory)\_Module&quot; &quot;$(GameFolder)\Modules\$(MSBuildProjectName)\&quot;" />

    <!-- Copy DLL to both bins -->
    <Exec Command="XCOPY /Y &quot;$(TargetPath)&quot; &quot;$(GameFolder)\Modules\$(MSBuildProjectName)\bin\Win64_Shipping_Client\&quot;" />
    <Exec Command="XCOPY /Y &quot;$(TargetPath)&quot; &quot;$(GameFolder)\Modules\$(MSBuildProjectName)\bin\Gaming.Desktop.x64_Shipping_Client\&quot;" />
  </Target>

  <PropertyGroup>
    <PackageDir>$(MSBuildProjectDirectory)\..\dist</PackageDir>
    <PackageStaging>$(MSBuildProjectDirectory)\obj\package</PackageStaging>
  </PropertyGroup>

  <Target Name="Package" AfterTargets="Build">
    <PropertyGroup>
      <PackageStamp>$([System.DateTime]::Now.ToString('yyyyMMdd-HHmm'))</PackageStamp>
      <PackageZip>$(PackageDir)\$(ModuleId)-$(PackageStamp).zip</PackageZip>
    </PropertyGroup>
    <RemoveDir Directories="$(PackageStaging)" />
    <MakeDir Directories="$(PackageDir)" />
    <ItemGroup>
      <PackageModuleFiles Include="$(MSBuildProjectDirectory)\_Module\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(PackageModuleFiles)" DestinationFiles="@(PackageModuleFiles -> '$(PackageStaging)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(PackageStaging)\bin\Win64_Shipping_Client\$(TargetFileName)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(PackageStaging)\bin\Gaming.Desktop.x64_Shipping_Client\$(TargetFileName)" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;Compress-Archive -Path '$(PackageStaging)\*' -DestinationPath '$(PackageZip)' -Force&quot;" />
    <Message Text="Packaged module: $(PackageZip)" Importance="high" />
  </Target>

</Project>
